languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem mlm2 dflt;

{# GDEF Table #}
table GDEF {
    GlyphClassDef [{{ gdef.bases | join(' ') }}], [{{ gdef.ligatures | join(' ') }}], [{{ gdef.marks | join(' ') }}], [];
} GDEF;

{% if mark_classes %}
{% for mark_class in mark_classes %}
    markClass {{ mark_class.glyph }} <anchor {{ mark_class.x }} {{ mark_class.y }}> @{{ mark_class.class_name }};
{% endfor %}

{% endif %}

{# Glyph Classes #}
{% for class_name, glyphs in glyph_classes.items() %}
@{{ class_name }} = [{{ glyphs | join(' ') }}];
{% endfor %}

{# === LOOKUP DEFINITIONS === #}

{# Latin Ligatures Lookup #}
lookup latin_ligatures {
    lookupflag 0;

{% for lig in ligatures.latin %}
    sub {{ lig.input | join(' ') }} by {{ lig.output }};
{% endfor %}

} latin_ligatures;

{# Malayalam Akhn Lookups #}
lookup zwj_chillus {
    lookupflag 0;

{% for chillu in chillus %}
    sub {{ chillu.input | join(' ') }} by {{ chillu.output }};
{% endfor %}
} zwj_chillus;

{% if conjuncts.conditional %}
lookup conditional_stack_lookup {
    lookupflag 0;

{% for conjunct in conjuncts.conditional %}
    sub {{ conjunct.input | join(' ') }} by {{ conjunct.output }};
{% endfor %}
} conditional_stack_lookup;
{% endif %}

lookup akhn_conjunctsDFLT_dflt_Substitution_4 {
    lookupflag 0;

{% for conjunct in conjuncts.basic %}
    sub {{ conjunct.input | join(' ') }} by {{ conjunct.output }};
{% endfor %}
} akhn_conjunctsDFLT_dflt_Substitution_4;

{% if conjuncts.chaining_rules %}
lookup akhn_conjunctsDFLT_dflt_Chaining_1 {
    lookupflag 0;

{% for rule in conjuncts.chaining_rules %}
    ignore sub {{ rule.ignore_pattern }};
    sub {{ rule.pattern }} lookup conditional_stack_lookup;
{% endfor %}
} akhn_conjunctsDFLT_dflt_Chaining_1;
{% endif %}

lookup cons_la {
    lookupflag 0;

{% for la_conj in conjuncts.la_conjuncts %}
    sub {{ la_conj.input | join(' ') }} by {{ la_conj.output }};
{% endfor %}
} cons_la;

lookup remove_dotted_circle {
    lookupflag 0;

{% for rule in aam_rules %}
    sub {{ rule.input | join(' ') }} by {{ rule.output }};
{% endfor %}
} remove_dotted_circle;

{% if conjuncts.fixup_rules %}
lookup split_cons_conj {
    lookupflag 0;

{% for rule in conjuncts.split_rules %}
    sub {{ rule.input }} by {{ rule.output | join(' ') }};
{% endfor %}
} split_cons_conj;

lookup akhn_conjuncts_fixup {
    lookupflag 0;

{% for rule in conjuncts.fixup_rules %}
    sub {{ rule.input }}' lookup split_cons_conj {{ rule.context }};
{% endfor %}
} akhn_conjuncts_fixup;
{% endif %}

{# Reph Lookups #}
lookup cons_signs {
    lookupflag 0;

{% for sign in cons_signs %}
    sub {{ sign.input | join(' ') }} by {{ sign.output }};
{% endfor %}
} cons_signs;

lookup split_cons_signs {
    lookupflag 0;

{% for sign in cons_signs %}
    sub {{ sign.output }} by {{ sign.input | join(' ') }};
{% endfor %}
} split_cons_signs;

lookup cons_signs_fix_order {
    lookupflag 0;

{% for rule in cons_signs_order_rules %}
    sub {{ rule.pattern }} lookup split_cons_signs;
{% endfor %}
} cons_signs_fix_order;

lookup pref_reph {
    lookupflag 0;

    sub {{ reph.input | join(' ') }} by {{ reph.output }};
} pref_reph;

lookup pres_reph {
    lookupflag 0;

{% for reph_rule in reph_conjuncts %}
    sub {{ reph_rule.input | join(' ') }} by {{ reph_rule.output }};
{% endfor %}
} pres_reph;

{# Vowel Signs Lookup #}
lookup psts_vowel_signs {
    lookupflag IgnoreMarks;

{% for rule in vowel_sign_rules %}
    sub {{ rule.input | join(' ') }} by {{ rule.output }};
{% endfor %}
} psts_vowel_signs;

{# Mark Positioning Lookups #}
lookup abvm_topmarks {
    lookupflag 0;

{% for anchor in top_anchors %}
        pos base [{{ anchor.bases | join(' ') }}]
            <anchor {{ anchor.x }} {{ anchor.y }}> mark @{{ anchor.class_name }};
{% endfor %}

} abvm_topmarks;

lookup blwm_bottommarks {
    lookupflag 0;

{% for anchor in bottom_anchors %}
        pos base {{ anchor.bases | join(' ') }}
            <anchor {{ anchor.x }} {{ anchor.y }}> mark @{{ anchor.class_name }};
{% endfor %}

} blwm_bottommarks;

{# Alternate Lookups #}
{% if calt_rules %}
{% for script, rules in calt_rules.items() %}
lookup {{ script }}_calt_lookup {
    lookupflag 0;

{% for rule in rules %}
    sub {{ rule.precontext }} {{ rule.base }}' by {{ rule.replacement }};
{% endfor %}
} {{ script }}_calt_lookup;
{% endfor %}
{% endif %}

{% if salts %}
lookup salts_lookup {
    lookupflag 0;

{% for base, alts in salts.items() %}
    sub {{ base }} from [{{ ([base] + alts) | join(' ') }}];
{% endfor %}
} salts_lookup;
{% endif %}

{% if sups %}
lookup sups_lookup {
    lookupflag 0;

{% for base, alt in sups.items() %}
    sub {{ base }} by {{ alt | join(' ') }};
{% endfor %}
} sups_lookup;
{% endif %}

{% if aalts %}
lookup aalts_lookupDFLT_dflt_Substitution_3 {
    lookupflag 0;

{% for rule in aalts.latin %}
    sub {{ rule.base }} from [{{ rule.alts | join(' ') }}];
{% endfor %}
} aalts_lookupDFLT_dflt_Substitution_3;

lookup aalts_lookupDFLT_dflt_Substitution_1 {
    lookupflag 0;

{% for rule in aalts.malayalam %}
    sub {{ rule.base }} by {{ rule.alt }};
{% endfor %}
} aalts_lookupDFLT_dflt_Substitution_1;
{% endif %}

{# === FEATURE DEFINITIONS === #}

{# Liga Feature #}
feature liga {
    script DFLT;
    language dflt;
            lookup latin_ligatures;

} liga;

feature liga {
    script latn;
    language dflt;
            lookup latin_ligatures;

} liga;

feature liga {
    script mlm2;
    language dflt;
            lookup latin_ligatures;

} liga;

{# Akhn Feature #}
feature akhn {
    script mlm2;
    language dflt;
            lookup zwj_chillus;

} akhn;

feature akhn {
    script mlm2;
    language dflt;
            lookup akhn_conjunctsDFLT_dflt_Substitution_4;

} akhn;

{% if conjuncts.chaining_rules %}
feature akhn {
    script mlm2;
    language dflt;
            lookup akhn_conjunctsDFLT_dflt_Chaining_1;

} akhn;
{% endif %}

feature akhn {
    script mlm2;
    language dflt;
            lookup cons_la;

} akhn;

feature akhn {
    script mlm2;
    language dflt;
            lookup remove_dotted_circle;

} akhn;

{% if conjuncts.fixup_rules %}
feature akhn {
    script mlm2;
    language dflt;
            lookup akhn_conjuncts_fixup;

} akhn;
{% endif %}

{# Pstf Feature #}
feature pstf {
    script mlm2;
    language dflt;
            lookup cons_signs;

} pstf;

feature pstf {
    script mlm2;
    language dflt;
            lookup cons_signs_fix_order;

} pstf;

{# Pref Feature #}
feature pref {
    script mlm2;
    language dflt;
            lookup pref_reph;

} pref;

{# Pres Feature #}
feature pres {
    script mlm2;
    language dflt;
            lookup pres_reph;

} pres;

{# Psts Feature #}
feature psts {
    script mlm2;
    language dflt;
            lookup psts_vowel_signs;

} psts;

{# Abvm Feature #}
feature abvm {
    script mlm2;
    language dflt;
            lookup abvm_topmarks;

} abvm;

{# Blwm Feature #}
feature blwm {
    script mlm2;
    language dflt;
            lookup blwm_bottommarks;

} blwm;

{# Calt Feature #}
{% if calt_rules %}
{% for script, rules in calt_rules.items() %}
feature calt {
    script {{ 'DFLT' if script == 'latin' else 'latn' if script == 'latin' else 'mlm2' }};
    language dflt;
            lookup {{ script }}_calt_lookup;

} calt;
{% endfor %}
{% endif %}

{# Salt Feature #}
{% if salts %}
feature salt {
    script mlm2;
    language dflt;
            lookup salts_lookup;

} salt;
{% endif %}

{# Sups Feature #}
{% if sups %}
feature sups {
    script DFLT;
    language dflt;
            lookup sups_lookup;

} sups;

feature sups {
    script latn;
    language dflt;
            lookup sups_lookup;

} sups;

feature sups {
    script mlm2;
    language dflt;
            lookup sups_lookup;

} sups;
{% endif %}
