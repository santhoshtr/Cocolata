table GDEF {
    GlyphClassDef [{{ gdef.bases | join(' ') }}], [{{ gdef.ligatures | join(' ') }}], [{{ gdef.marks | join(' ') }}], [];
} GDEF;

{% if mark_classes %}
{% for mark_class in mark_classes %}
    markClass {{ mark_class.glyph }} <anchor {{ mark_class.x }} {{ mark_class.y }}> @{{ mark_class.class_name }};
{% endfor %}

{% endif %}
