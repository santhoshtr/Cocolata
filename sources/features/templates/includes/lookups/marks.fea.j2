lookup abvm_topmarks {
    lookupflag 0;

{% for anchor in top_anchors %}
        pos base [{{ anchor.bases | join(' ') }}]
            <anchor {{ anchor.x }} {{ anchor.y }}> mark @{{ anchor.class_name }};
{% endfor %}

} abvm_topmarks;

lookup blwm_bottommarks {
    lookupflag 0;

{% for anchor in bottom_anchors %}
        pos base {{ anchor.bases | join(' ') }}
            <anchor {{ anchor.x }} {{ anchor.y }}> mark @{{ anchor.class_name }};
{% endfor %}

} blwm_bottommarks;


