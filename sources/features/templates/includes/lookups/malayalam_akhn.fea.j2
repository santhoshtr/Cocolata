lookup zwj_chillus {
    lookupflag 0;

{% for chillu in chillus %}
    sub {{ chillu.input | join(' ') }} by {{ chillu.output }};
{% endfor %}
} zwj_chillus;

{% if conjuncts.conditional %}
lookup conditional_stack_lookup {
    lookupflag 0;

{% for conjunct in conjuncts.conditional %}
    sub {{ conjunct.input | join(' ') }} by {{ conjunct.output }};
{% endfor %}
} conditional_stack_lookup;
{% endif %}

lookup akhn_conjunctsDFLT_dflt_Substitution_4 {
    lookupflag 0;

{% for conjunct in conjuncts.basic %}
    sub {{ conjunct.input | join(' ') }} by {{ conjunct.output }};
{% endfor %}
} akhn_conjunctsDFLT_dflt_Substitution_4;

{% if conjuncts.chaining_rules %}
lookup akhn_conjunctsDFLT_dflt_Chaining_1 {
    lookupflag 0;

{% for rule in conjuncts.chaining_rules %}
    ignore sub {{ rule.ignore_pattern }};
    sub {{ rule.pattern }} lookup conditional_stack_lookup;
{% endfor %}
} akhn_conjunctsDFLT_dflt_Chaining_1;
{% endif %}

lookup cons_la {
