} remove_dotted_circle;

{% if conjuncts.fixup_rules %}
lookup split_cons_conj {
    lookupflag 0;

{% for rule in conjuncts.split_rules %}
    sub {{ rule.input }} by {{ rule.output | join(' ') }};
{% endfor %}
} split_cons_conj;

lookup akhn_conjuncts_fixup {
    lookupflag 0;

{% for rule in conjuncts.fixup_rules %}
    sub {{ rule.input }}' lookup split_cons_conj {{ rule.context }};
{% endfor %}
} akhn_conjuncts_fixup;
{% endif %}
