
{% if calt_rules %}
{% for script, rules in calt_rules.items() %}
lookup {{ script }}_calt_lookup {
    lookupflag 0;

{% for rule in rules %}
    sub {{ rule.precontext }} {{ rule.base }}' by {{ rule.replacement }};
{% endfor %}
} {{ script }}_calt_lookup;
{% endfor %}
{% endif %}

{% if salts %}
lookup salts_lookup {
    lookupflag 0;

{% for base, alts in salts.items() %}
    sub {{ base }} from [{{ ([base] + alts) | join(' ') }}];
{% endfor %}
} salts_lookup;
{% endif %}

{% if sups %}
lookup sups_lookup {
    lookupflag 0;

{% for base, alt in sups.items() %}
    sub {{ base }} by {{ alt | join(' ') }};
{% endfor %}
} sups_lookup;
{% endif %}

{% if aalts %}
lookup aalts_lookupDFLT_dflt_Substitution_3 {
    lookupflag 0;

{% for rule in aalts.latin %}
    sub {{ rule.base }} from [{{ rule.alts | join(' ') }}];
{% endfor %}
} aalts_lookupDFLT_dflt_Substitution_3;

lookup aalts_lookupDFLT_dflt_Substitution_1 {
    lookupflag 0;

{% for rule in aalts.malayalam %}
    sub {{ rule.base }} by {{ rule.alt }};
{% endfor %}
} aalts_lookupDFLT_dflt_Substitution_1;
{% endif %}
